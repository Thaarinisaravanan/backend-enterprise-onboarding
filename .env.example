# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_VERSION=1.0.0

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_onboarding

# Test database (used by integration and e2e tests)
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/enterprise_onboarding_test

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
# Must be a long, random string — never commit the real value
JWT_SECRET=change-me-use-a-long-random-string-at-least-64-chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ──────────────────────────────────────────────
# BullMQ
# ──────────────────────────────────────────────
BULL_QUEUE_LOW_STOCK=low-stock-alerts

# ──────────────────────────────────────────────
# Inventory thresholds
# ──────────────────────────────────────────────
LOW_STOCK_THRESHOLD=10

# ──────────────────────────────────────────────
# Cache
# ──────────────────────────────────────────────
CACHE_TTL_SECONDS=60

# ──────────────────────────────────────────────
# Bcrypt
# ──────────────────────────────────────────────
BCRYPT_ROUNDS=12
